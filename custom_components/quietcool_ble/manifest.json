{
  "domain": "quietcool_ble",
  "name": "QuietCool BLE",
  "bluetooth": [
    {
      "local_name": "ATTICFAN*",
      "connectable": true
    }
  ],
  "codeowners": ["@rwarner"],
  "config_flow": true,
  "dependencies": ["bluetooth_adapters"],
